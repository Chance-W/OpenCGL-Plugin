<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import com.opencgl.base.controls.CustomTextArea?>
<?import io.github.palexdev.mfxresources.fonts.MFXFontIcon?>
<?import org.fxmisc.flowless.VirtualizedScrollPane?>
<StackPane fx:id="mainStackPane" xmlns="http://javafx.com/javafx/10.0.2-internal" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.opencgl.controller.RocketMqProducerWidgetController"
           stylesheets="@./com/opencgl/css/RocketMqWidgetView.css">
    <BorderPane fx:id="contentBorderPane" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <top>
            <VBox spacing="1.0" BorderPane.alignment="CENTER">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <MFXButton fx:id="refreshButton" buttonType="RAISED" onMouseClicked="#refreshLabelAction"
                               prefHeight="30.0" prefWidth="10.0" text="">
                        <graphic>
                            <MFXFontIcon description="fas-arrows-rotate" size="15.0"/>
                        </graphic>
                    </MFXButton>
                    <MFXButton fx:id="copyButton" buttonType="RAISED" onMouseClicked="#copyLabelAction"
                               prefHeight="30.0" prefWidth="10.0" text="">
                        <graphic>
                            <MFXFontIcon description="fas-copy" size="15.0"/>
                        </graphic>
                    </MFXButton>
                    <MFXButton fx:id="saveButton" buttonType="RAISED" onMouseClicked="#saveLabelAction"
                               prefHeight="30.0" prefWidth="10.0" text="">
                        <graphic>
                            <MFXFontIcon description="fas-floppy-disk" size="15.0"/>
                        </graphic>
                    </MFXButton>
                    <MFXTextField fx:id="nameServerAddrTextField" prefHeight="30"
                                  prefWidth="200.0" promptText="%prompt.namesrv_addr"
                                  style="-fx-prompt-text-fill:-theme-text-secondary"
                                  HBox.hgrow="ALWAYS">
                    </MFXTextField>
                    <MFXTextField fx:id="topicTextField" prefHeight="30"
                                  prefWidth="300.0" promptText="%prompt.topic" style="-fx-prompt-text-fill:-theme-text-secondary">
                    </MFXTextField>
                    <MFXTextField fx:id="tagsTextField" prefHeight="30"
                                  prefWidth="170" promptText="%prompt.tags" style="-fx-prompt-text-fill:-theme-text-secondary">
                    </MFXTextField>
                    <MFXTextField fx:id="countTextField" text="1" prefHeight="30"
                                  prefWidth="50" promptText="%prompt.loop_count" style="-fx-prompt-text-fill:-theme-text-secondary">
                    </MFXTextField>
                    <MFXButton fx:id="sendButton" buttonType="RAISED" onMouseClicked="#sendLabelAction"
                               prefHeight="30.0" prefWidth="10.0" text="">
                        <graphic>
                            <MFXFontIcon description="fas-play" size="15.0"/>
                        </graphic>
                        <HBox.margin>
                            <Insets right="10.0"/>
                        </HBox.margin>
                    </MFXButton>
                    <padding>
                        <Insets left="10.0" top="10"/>
                    </padding>
                    <HBox.margin>
                        <Insets right="10.0"/>
                    </HBox.margin>
                    <VBox.margin>
                        <Insets bottom="5.0" top="5.0"/>
                    </VBox.margin>
                </HBox>
            </VBox>
        </top>
        <center>
            <StackPane fx:id="contentPanel">
                <SplitPane dividerPositions="0.5">
                    <AnchorPane>
                        <VirtualizedScrollPane AnchorPane.bottomAnchor="0"
                                               AnchorPane.leftAnchor="0"
                                               AnchorPane.rightAnchor="0"
                                               AnchorPane.topAnchor="0">
                            <content>
                                <CustomTextArea fx:id="inputTextArea"/>
                            </content>
                        </VirtualizedScrollPane>

                    </AnchorPane>
                    <AnchorPane>
                        <VirtualizedScrollPane AnchorPane.bottomAnchor="0"
                                               AnchorPane.leftAnchor="0"
                                               AnchorPane.rightAnchor="0"
                                               AnchorPane.topAnchor="0">
                            <content>
                                <CustomTextArea wrapText="true" fx:id="outputTextArea"/>
                            </content>
                        </VirtualizedScrollPane>

                    </AnchorPane>
                </SplitPane>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
