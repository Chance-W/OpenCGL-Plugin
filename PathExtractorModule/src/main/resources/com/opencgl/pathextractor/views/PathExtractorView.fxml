<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.fxmisc.richtext.CodeArea?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
        <ToggleGroup fx:id="typeGroup"/>
    </fx:define>
    
    <top>
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            
            <!-- 类型选择 -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <RadioButton fx:id="jsonRadio" text="%label.json" toggleGroup="$typeGroup" selected="true"/>
                <RadioButton fx:id="xmlRadio" text="%label.xml" toggleGroup="$typeGroup"/>
                <Button fx:id="openFileButton" text="%btn.openFile"/>
                <Button fx:id="clearButton" text="%btn.clear"/>
            </HBox>
            
            <!-- 输入数据 -->
            <Label fx:id="inputDataLabel" text="%label.inputData" style="-fx-font-weight: bold;"/>
            <CodeArea fx:id="inputArea" prefHeight="200" VBox.vgrow="SOMETIMES"/>
            
            <!-- 路径表达式 -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="pathLabel" text="%label.pathExpression" style="-fx-font-weight: bold;"/>
                <TextField fx:id="pathField" HBox.hgrow="ALWAYS" 
                           promptText="%prompt.pathJson"/>
                <Button fx:id="extractButton" text="%btn.extract" styleClass="primary-button" prefWidth="100"/>
            </HBox>
            
            <!-- 常用示例 -->
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label fx:id="exampleLabel" text="%label.example"/>
                <Button fx:id="example1Button" text="$.store.book[0]" style="-fx-font-size: 10px;"/>
                <Button fx:id="example2Button" text="$..*" style="-fx-font-size: 10px;"/>
                <Button fx:id="example3Button" text="//book[@id='1']" style="-fx-font-size: 10px;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <!-- 提取结果 -->
        <VBox spacing="5">
            <padding><Insets top="0" right="10" bottom="10" left="10"/></padding>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="resultLabel" text="%label.result" style="-fx-font-weight: bold;"/>
                <Label fx:id="statusLabel" text="%label.statusReady" style="-fx-text-fill: -theme-text-secondary;"/>
            </HBox>
            
            <CodeArea fx:id="resultArea" editable="false" VBox.vgrow="ALWAYS" prefHeight="200"/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
            <Button fx:id="copyButton" text="%btn.copyResult"/>
            <Button fx:id="formatButton" text="%btn.formatInput"/>
        </HBox>
    </bottom>
</BorderPane>
