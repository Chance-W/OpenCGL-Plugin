<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import org.fxmisc.flowless.VirtualizedScrollPane?>
<?import com.opencgl.base.controls.CustomTextArea?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXFilterComboBox?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import io.github.palexdev.mfxresources.fonts.MFXFontIcon?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<StackPane fx:id="mainStackPane" xmlns="http://javafx.com/javafx/10.0.2-internal" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.opencgl.controller.RestWidgetController"
           stylesheets="@./com/opencgl/css/RestWidgetView.css">
    <fx:define>
        <ToggleGroup fx:id="bodyTypeToggleGroup"/>
    </fx:define>
    <BorderPane fx:id="contentBorderPane" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <top>
            <VBox fx:id="operateTopVbox" BorderPane.alignment="CENTER" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
                <!-- 工具栏 -->
                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #f8f9fa; -fx-padding: 8 12;">
                    <MFXButton fx:id="refreshButton" buttonType="RAISED"
                               onMouseClicked="#refreshLabelAction"
                               prefHeight="32.0"
                               prefWidth="32.0"
                               style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 4;"
                               text="">
                        <graphic>
                            <MFXFontIcon description="fas-arrows-rotate" size="14.0" style="-fx-fill: white;"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="刷新请求列表"/>
                        </tooltip>
                    </MFXButton>
                    <MFXButton fx:id="copyButton" buttonType="RAISED" onMouseClicked="#copyLabelAction"
                               prefHeight="32.0"
                               prefWidth="32.0"
                               style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-background-radius: 4;"
                               text="">
                        <graphic>
                            <MFXFontIcon description="fas-copy" size="14.0" style="-fx-fill: white;"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="复制请求"/>
                        </tooltip>
                    </MFXButton>
                    <MFXButton fx:id="saveButton" buttonType="RAISED" onMouseClicked="#saveLabelAction"
                               prefHeight="32.0"
                               prefWidth="32.0"
                               style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 4;"
                               text="">
                        <graphic>
                            <MFXFontIcon description="fas-floppy-disk" size="14.0" style="-fx-fill: white;"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="保存请求"/>
                        </tooltip>
                    </MFXButton>
                    
                    <!-- 分隔线 -->
                    <Separator orientation="VERTICAL" prefHeight="24.0" style="-fx-background-color: #dee2e6;"/>
                    
                    <!-- 环境选择器 -->
                    <MFXFilterComboBox fx:id="environmentComboBox"
                                       floatingText="Environment"
                                       prefWidth="120.0"
                                       style="-fx-background-color: white; -fx-border-color: #ced4da; -fx-border-radius: 4;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="No Environment"/>
                                <String fx:value="Development"/>
                                <String fx:value="Staging"/>
                                <String fx:value="Production"/>
                            </FXCollections>
                        </items>
                    </MFXFilterComboBox>
                </HBox>
                
                <!-- 请求行 -->
                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #f8f9fa; -fx-padding: 0 12 8 12;">
                    <MFXFilterComboBox fx:id="chooseMetComboBox"
                                       floatingText="Method"
                                       prefWidth="120.0"
                                       style="-fx-background-color: white; -fx-border-color: #ced4da; -fx-border-radius: 4;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="GET"/>
                                <String fx:value="POST"/>
                                <String fx:value="PUT"/>
                                <String fx:value="PATCH"/>
                                <String fx:value="DELETE"/>
                                <String fx:value="HEAD"/>
                                <String fx:value="OPTIONS"/>
                                <String fx:value="TRACE"/>
                                <String fx:value="CONNECT"/>
                            </FXCollections>
                        </items>
                    </MFXFilterComboBox>
                    
                    <MFXTextField fx:id="urlTextField"
                                  floatMode="BORDER" 
                                  floatingText="Enter request URL"
                                  prefHeight="36" 
                                  prefWidth="800"
                                  style="-fx-background-color: white; -fx-border-color: #ced4da; -fx-border-radius: 4; -fx-font-size: 14;">
                    </MFXTextField>
                    
                    <MFXButton fx:id="sendButton" buttonType="RAISED" onMouseClicked="#sendLabelAction"
                               prefHeight="36.0"
                               prefWidth="80.0"
                               style="-fx-background-color: #ff6b35; -fx-text-fill: white; -fx-background-radius: 4; -fx-font-weight: bold;"
                               text="Send">
                        <graphic>
                            <MFXFontIcon description="fas-paper-plane" size="14.0" style="-fx-fill: white;"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="发送请求 (Ctrl+Enter)"/>
                        </tooltip>
                    </MFXButton>
                </HBox>
            </VBox>
        </top>
        <center>
            <StackPane fx:id="contentInputAndOutputPane">
                <SplitPane fx:id="splitPane" dividerPositions="0.5">
                    <AnchorPane>
                        <TabPane fx:id="restJfxTabPane"
                                 AnchorPane.bottomAnchor="0"
                                 AnchorPane.leftAnchor="0"
                                 AnchorPane.rightAnchor="0"
                                 AnchorPane.topAnchor="0"
                                 tabClosingPolicy="UNAVAILABLE">
                            <Tab text="Headers">
                                <AnchorPane>
                                    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                                                AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                        <top>
                                            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 8;">
                                                <Label text="Headers" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                                <MFXButton buttonType="RAISED" fx:id="headersPresetButton" 
                                                           style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 4;"
                                                           text="Presets" prefHeight="28.0" prefWidth="60.0">
                                                    <tooltip>
                                                        <Tooltip text="常用头部预设"/>
                                                    </tooltip>
                                                </MFXButton>
                                                <MFXButton buttonType="RAISED" fx:id="headersAddButton" 
                                                           style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 4;"
                                                           text="+" prefHeight="28.0" prefWidth="28.0">
                                                    <tooltip>
                                                        <Tooltip text="添加头部"/>
                                                    </tooltip>
                                                </MFXButton>
                                                <MFXButton buttonType="RAISED" fx:id="headersDelButton" 
                                                           style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 4;"
                                                           text="-" prefHeight="28.0" prefWidth="28.0">
                                                    <tooltip>
                                                        <Tooltip text="删除选中头部"/>
                                                    </tooltip>
                                                </MFXButton>
                                                <MFXButton buttonType="RAISED" fx:id="headersClearButton" 
                                                           style="-fx-background-color: #ffc107; -fx-text-fill: white; -fx-background-radius: 4;"
                                                           text="Clear" prefHeight="28.0" prefWidth="50.0">
                                                    <tooltip>
                                                        <Tooltip text="清空所有头部"/>
                                                    </tooltip>
                                                </MFXButton>
                                            </HBox>
                                        </top>
                                        <center>
                                            <AnchorPane>
                                                <TreeTableView fx:id="headers" editable="true" AnchorPane.bottomAnchor="0"
                                                           AnchorPane.leftAnchor="0"
                                                           AnchorPane.rightAnchor="0"
                                                           AnchorPane.topAnchor="0">
                                                    <columns>
                                                        <TreeTableColumn fx:id="headersKey"
                                                                     text="KEY" minWidth="140"/>
                                                        <TreeTableColumn fx:id="headersValue"
                                                                     text="VALUE" minWidth="140"/>
                                                        <TreeTableColumn fx:id="headersDescription"
                                                                     text="DESCRIPTION"
                                                                     minWidth="140"/>
                                                    </columns>
                                                </TreeTableView>
                                            </AnchorPane>
                                        </center>
                                    </BorderPane>
                                </AnchorPane>
                            </Tab>
                            <Tab text="Cookie">
                                <AnchorPane>
                                    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                                                AnchorPane.rightAnchor="0"
                                                AnchorPane.topAnchor="0">
                                        <top>
                                            <HBox alignment="CENTER_RIGHT" spacing="5">
                                                <MFXButton buttonType="RAISED" fx:id="cookiesAddButton" text="+"/>
                                                <MFXButton buttonType="RAISED" fx:id="cookiesDelButton" text="-"/>
                                            </HBox>
                                        </top>
                                        <center>
                                            <TreeTableView fx:id="cookies" editable="true"
                                                       AnchorPane.bottomAnchor="0"
                                                       AnchorPane.leftAnchor="0"
                                                       AnchorPane.rightAnchor="0"
                                                       AnchorPane.topAnchor="0">
                                                <columns>
                                                    <TreeTableColumn fx:id="cookiesKey"
                                                                     text="KEY" minWidth="140"/>
                                                    <TreeTableColumn fx:id="cookiesValue"
                                                                     text="VALUE" minWidth="140"/>
                                                    <TreeTableColumn fx:id="cookiesDescription"
                                                                     text="DESCRIPTION" minWidth="140"/>
                                                </columns>
                                            </TreeTableView>
                                        </center>
                                    </BorderPane>
                                </AnchorPane>
                            </Tab>
                            <Tab text="Body">
                                <AnchorPane>
                                    <BorderPane AnchorPane.bottomAnchor="0"
                                                AnchorPane.leftAnchor="0"
                                                AnchorPane.rightAnchor="0"
                                                AnchorPane.topAnchor="0">
                                        <top>
                                            <VBox spacing="8" style="-fx-padding: 12;">
                                                <!-- Body 类型选择 -->
                                                <HBox alignment="CENTER_LEFT" spacing="12">
                                                    <Label text="Body Type:" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                                    <RadioButton fx:id="noneRadioButton" text="None" toggleGroup="$bodyTypeToggleGroup" selected="true"/>
                                                    <RadioButton fx:id="rawRadioButton" text="raw" toggleGroup="$bodyTypeToggleGroup"/>
                                                    <RadioButton fx:id="formDataRadioButton" text="form-data" toggleGroup="$bodyTypeToggleGroup"/>
                                                    <RadioButton fx:id="xwwwFormUrlencodedRadioButton" text="x-www-form-urlencoded" toggleGroup="$bodyTypeToggleGroup"/>
                                                    <RadioButton fx:id="binaryRadioButton" text="binary" toggleGroup="$bodyTypeToggleGroup"/>
                                                </HBox>
                                                
                                                <!-- 内容类型选择 -->
                                                <HBox alignment="CENTER_LEFT" spacing="12" visible="false" fx:id="contentTypeHBox">
                                                    <Label text="Content Type:" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                                    <MFXFilterComboBox fx:id="chooseMediaTypeComboBox"
                                                                       floatingText="Select content type"
                                                                       prefWidth="200.0"
                                                                       style="-fx-background-color: white; -fx-border-color: #ced4da; -fx-border-radius: 4;">
                                                        <items>
                                                            <FXCollections fx:factory="observableArrayList">
                                                                <String fx:value="application/json"/>
                                                                <String fx:value="application/xml"/>
                                                                <String fx:value="text/xml"/>
                                                                <String fx:value="text/plain"/>
                                                                <String fx:value="text/html"/>
                                                                <String fx:value="application/javascript"/>
                                                                <String fx:value="application/x-www-form-urlencoded"/>
                                                                <String fx:value="multipart/form-data"/>
                                                                <String fx:value="multipart/mixed"/>
                                                            </FXCollections>
                                                        </items>
                                                    </MFXFilterComboBox>
                                                    
                                                    <!-- 格式化按钮 -->
                                                    <MFXButton fx:id="formatButton" buttonType="RAISED" 
                                                               prefHeight="28.0" prefWidth="60.0"
                                                               style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 4;"
                                                               text="Format">
                                                        <tooltip>
                                                            <Tooltip text="格式化 JSON/XML"/>
                                                        </tooltip>
                                                    </MFXButton>
                                                    
                                                    <!-- 清空按钮 -->
                                                    <MFXButton fx:id="clearBodyButton" buttonType="RAISED" 
                                                               prefHeight="28.0" prefWidth="60.0"
                                                               style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 4;"
                                                               text="Clear">
                                                        <tooltip>
                                                            <Tooltip text="清空内容"/>
                                                        </tooltip>
                                                    </MFXButton>
                                                </HBox>
                                            </VBox>
                                        </top>
                                
                                        <center>
                                            <AnchorPane>
                                                <VirtualizedScrollPane AnchorPane.bottomAnchor="0"
                                                                       AnchorPane.leftAnchor="0"
                                                                       AnchorPane.rightAnchor="0"
                                                                       AnchorPane.topAnchor="0">
                                                    <content>
                                                        <CustomTextArea fx:id="inputTextArea" 
                                                                        style="-fx-font-family: 'Consolas', 'Monaco', monospace; -fx-font-size: 13;"/>
                                                    </content>
                                                </VirtualizedScrollPane>
                                            </AnchorPane>
                                        </center>
                                    </BorderPane>
                                </AnchorPane>
                            </Tab>
                        </TabPane>
                    </AnchorPane>
                    <AnchorPane minHeight="0.0" minWidth="0.0">
                        <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                            <top>
                                <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
                                    <!-- 响应状态信息 -->
                                    <HBox alignment="CENTER_LEFT" spacing="20">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="Status:" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                            <Label fx:id="statusCodeLabel" text="-" style="-fx-font-weight: bold; -fx-text-fill: #28a745;"/>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="Time:" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                            <Label fx:id="responseTimeLabel" text="-" style="-fx-text-fill: #6c757d;"/>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="Size:" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                            <Label fx:id="responseSizeLabel" text="-" style="-fx-text-fill: #6c757d;"/>
                                        </HBox>
                                    </HBox>
                                    
                                    <!-- 响应标签页 -->
                                    <TabPane fx:id="responseTabPane" tabClosingPolicy="UNAVAILABLE" style="-fx-tab-min-width: 80;">
                                        <Tab text="Body">
                                            <AnchorPane>
                                                <VirtualizedScrollPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                                    <content>
                                                        <CustomTextArea fx:id="outputTextArea" wrapText="true" 
                                                                        style="-fx-font-family: 'Consolas', 'Monaco', monospace; -fx-font-size: 13;"/>
                                                    </content>
                                                </VirtualizedScrollPane>
                                            </AnchorPane>
                                        </Tab>
                                        <Tab text="Headers">
                                            <AnchorPane>
                                                <TreeTableView fx:id="responseHeaders" editable="false" 
                                                               AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                                    <columns>
                                                        <TreeTableColumn fx:id="responseHeadersKey" text="Header Name" minWidth="200"/>
                                                        <TreeTableColumn fx:id="responseHeadersValue" text="Value" minWidth="300"/>
                                                    </columns>
                                                </TreeTableView>
                                            </AnchorPane>
                                        </Tab>
                                        <Tab text="Cookies">
                                            <AnchorPane>
                                                <TreeTableView fx:id="responseCookies" editable="false"
                                                               AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                                    <columns>
                                                        <TreeTableColumn fx:id="responseCookiesKey" text="Name" minWidth="150"/>
                                                        <TreeTableColumn fx:id="responseCookiesValue" text="Value" minWidth="200"/>
                                                        <TreeTableColumn fx:id="responseCookiesDomain" text="Domain" minWidth="150"/>
                                                        <TreeTableColumn fx:id="responseCookiesPath" text="Path" minWidth="100"/>
                                                    </columns>
                                                </TreeTableView>
                                            </AnchorPane>
                                        </Tab>
                                    </TabPane>
                                </VBox>
                            </top>
                        </BorderPane>
                    </AnchorPane>
                </SplitPane>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
