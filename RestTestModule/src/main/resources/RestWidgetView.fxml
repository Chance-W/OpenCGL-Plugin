<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import org.fxmisc.flowless.VirtualizedScrollPane?>
<?import com.opencgl.base.controls.CustomTextArea?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXComboBox?>
<?import io.github.palexdev.materialfx.controls.MFXFilterComboBox?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import io.github.palexdev.mfxresources.fonts.MFXFontIcon?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<StackPane fx:id="mainStackPane" xmlns="http://javafx.com/javafx/10.0.2-internal" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.opencgl.controller.RestWidgetController"
           stylesheets="@./com/opencgl/css/RestWidgetView.css">
    <fx:define>
        <ToggleGroup fx:id="bodyTypeToggleGroup"/>
    </fx:define>
    <BorderPane fx:id="contentBorderPane" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <top>
            <VBox fx:id="operateTopVbox" BorderPane.alignment="CENTER" style="-fx-background-color: -theme-bg-secondary; -fx-border-color: -theme-border; -fx-border-width: 0 0 1 0;">
                <!-- 工具栏 -->
                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: -theme-bg-secondary; -fx-padding: 8 12;">
                    <MFXButton fx:id="refreshButton" buttonType="RAISED"
                               onMouseClicked="#refreshLabelAction"
                               prefHeight="32.0"
                               prefWidth="32.0"
                               style="-fx-background-color: -theme-bg-tertiary; -fx-text-fill: -theme-text-inverse; -fx-background-radius: 4;"
                               text="">
                        <graphic>
                            <MFXFontIcon description="fas-arrows-rotate" size="14.0" style="-fx-fill: -theme-text-inverse;"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="%tooltip.refresh"/>
                        </tooltip>
                    </MFXButton>
                    <MFXButton fx:id="copyButton" buttonType="RAISED" onMouseClicked="#copyLabelAction"
                               prefHeight="32.0"
                               prefWidth="32.0"
                               style="-fx-background-color: -theme-info; -fx-text-fill: -theme-text-inverse; -fx-background-radius: 4;"
                               text="">
                        <graphic>
                            <MFXFontIcon description="fas-copy" size="14.0" style="-fx-fill: -theme-text-inverse;"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="%tooltip.copy"/>
                        </tooltip>
                    </MFXButton>
                    <MFXButton fx:id="saveButton" buttonType="RAISED" onMouseClicked="#saveLabelAction"
                               prefHeight="32.0"
                               prefWidth="32.0"
                               style="-fx-background-color: -theme-success; -fx-text-fill: -theme-text-inverse; -fx-background-radius: 4;"
                               text="">
                        <graphic>
                            <MFXFontIcon description="fas-floppy-disk" size="14.0" style="-fx-fill: -theme-text-inverse;"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="%tooltip.save"/>
                        </tooltip>
                    </MFXButton>
                    <MFXButton fx:id="curlButton" buttonType="RAISED" onMouseClicked="#exportToCurlAction"
                               prefHeight="32.0"
                               prefWidth="32.0"
                               style="-fx-background-color: -theme-accent; -fx-text-fill: -theme-text-inverse; -fx-background-radius: 4;"
                               text="">
                        <graphic>
                            <MFXFontIcon description="fas-terminal" size="14.0" style="-fx-fill: -theme-text-inverse;"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="%tooltip.export_curl"/>
                        </tooltip>
                    </MFXButton>
                    
                    <!-- 分隔线 -->
                    <Separator orientation="VERTICAL" prefHeight="24.0" style="-fx-background-color: -theme-border;"/>
                    
                    <!-- 环境选择器 -->
                    <MFXFilterComboBox fx:id="environmentComboBox"
                                       floatingText="%floatingText.environment"
                                       prefWidth="120.0"
                                       style="-fx-background-color: -theme-bg-tertiary; -fx-border-color: -theme-border; -fx-border-radius: 4;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="%item.no_environment"/>
                                <String fx:value="%item.development"/>
                                <String fx:value="%item.staging"/>
                                <String fx:value="%item.production"/>
                            </FXCollections>
                        </items>
                    </MFXFilterComboBox>
                    
                    <!-- Hook 脚本选择器 -->
                    <MFXComboBox fx:id="hookScriptCombo"
                                 prefWidth="120.0"
                                 prefHeight="30.0"
                                 floatMode="DISABLED"
                                 promptText="%promptText.hook_script">
                        <tooltip>
                            <Tooltip text="%tooltip.hook_script"/>
                        </tooltip>
                    </MFXComboBox>
                </HBox>
                
                <!-- 请求行 -->
                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: -theme-bg-secondary; -fx-padding: 0 12 8 12;">
                    <MFXFilterComboBox fx:id="chooseMetComboBox"
                                       floatingText="%floatingText.method"
                                       prefWidth="120.0"
                                       style="-fx-background-color: -theme-bg-tertiary; -fx-border-color: -theme-border; -fx-border-radius: 4;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="GET"/>
                                <String fx:value="POST"/>
                                <String fx:value="PUT"/>
                                <String fx:value="PATCH"/>
                                <String fx:value="DELETE"/>
                                <String fx:value="HEAD"/>
                                <String fx:value="OPTIONS"/>
                                <String fx:value="TRACE"/>
                                <String fx:value="CONNECT"/>
                            </FXCollections>
                        </items>
                    </MFXFilterComboBox>
                    
                    <MFXTextField fx:id="urlTextField"
                                  floatMode="BORDER" 
                                  floatingText="%floatingText.url"
                                  prefHeight="36" 
                                  prefWidth="800"
                                  style="-fx-background-color: -theme-bg-tertiary; -fx-border-color: -theme-border; -fx-border-radius: 4; -fx-font-size: 14;">
                    </MFXTextField>
                    
                    <MFXButton fx:id="sendButton" buttonType="RAISED" onMouseClicked="#sendLabelAction"
                               prefHeight="36.0"
                               prefWidth="80.0"
                               style="-fx-background-color: -theme-accent; -fx-text-fill: -theme-text-inverse; -fx-background-radius: 4; -fx-font-weight: bold;"
                               text="%button.send">
                        <graphic>
                            <MFXFontIcon description="fas-paper-plane" size="14.0" style="-fx-fill: -theme-text-inverse;"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="%tooltip.send"/>
                        </tooltip>
                    </MFXButton>
                </HBox>
            </VBox>
        </top>
        <center>
            <StackPane fx:id="contentInputAndOutputPane">
                <SplitPane fx:id="splitPane" dividerPositions="0.5">
                    <AnchorPane>
                        <TabPane fx:id="restJfxTabPane"
                                 AnchorPane.bottomAnchor="0"
                                 AnchorPane.leftAnchor="0"
                                 AnchorPane.rightAnchor="0"
                                 AnchorPane.topAnchor="0"
                                 tabClosingPolicy="UNAVAILABLE">
                            <Tab text="%tab.headers">
                                <AnchorPane>
                                    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                                                AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                        <top>
                                            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 8;">
                                                <Label text="%label.headers" style="-fx-font-weight: bold; -fx-text-fill: -theme-text-primary;"/>
                                                <MFXButton buttonType="RAISED" fx:id="headersPresetButton" 
                                                           style="-fx-background-color: -theme-bg-tertiary; -fx-text-fill: -theme-text-inverse; -fx-background-radius: 4;"
                                                           text="%button.presets" prefHeight="28.0" prefWidth="60.0">
                                                    <tooltip>
                                                        <Tooltip text="%tooltip.presets"/>
                                                    </tooltip>
                                                </MFXButton>
                                                <MFXButton buttonType="RAISED" fx:id="headersAddButton" 
                                                           style="-fx-background-color: -theme-success; -fx-text-fill: -theme-text-inverse; -fx-background-radius: 4;"
                                                           text="%button.add_header" prefHeight="28.0" prefWidth="28.0">
                                                    <tooltip>
                                                        <Tooltip text="%tooltip.add_header"/>
                                                    </tooltip>
                                                </MFXButton>
                                                <MFXButton buttonType="RAISED" fx:id="headersDelButton" 
                                                           style="-fx-background-color: -theme-danger; -fx-text-fill: -theme-text-inverse; -fx-background-radius: 4;"
                                                           text="%button.del_header" prefHeight="28.0" prefWidth="28.0">
                                                    <tooltip>
                                                        <Tooltip text="%tooltip.del_header"/>
                                                    </tooltip>
                                                </MFXButton>
                                                <MFXButton buttonType="RAISED" fx:id="headersClearButton" 
                                                           style="-fx-background-color: -theme-warning; -fx-text-fill: -theme-text-inverse; -fx-background-radius: 4;"
                                                           text="%button.clear" prefHeight="28.0" prefWidth="50.0">
                                                    <tooltip>
                                                        <Tooltip text="%tooltip.clear_headers"/>
                                                    </tooltip>
                                                </MFXButton>
                                            </HBox>
                                        </top>
                                        <center>
                                            <AnchorPane>
                                                <TreeTableView fx:id="headers" editable="true" AnchorPane.bottomAnchor="0"
                                                           AnchorPane.leftAnchor="0"
                                                           AnchorPane.rightAnchor="0"
                                                           AnchorPane.topAnchor="0">
                                                    <columns>
                                                        <TreeTableColumn fx:id="headersKey"
                                                                     text="%col.key" minWidth="140"/>
                                                        <TreeTableColumn fx:id="headersValue"
                                                                     text="%col.value" minWidth="140"/>
                                                        <TreeTableColumn fx:id="headersDescription"
                                                                     text="%col.description"
                                                                     minWidth="140"/>
                                                    </columns>
                                                </TreeTableView>
                                            </AnchorPane>
                                        </center>
                                    </BorderPane>
                                </AnchorPane>
                            </Tab>
                            <Tab text="%tab.cookie">
                                <AnchorPane>
                                    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                                                AnchorPane.rightAnchor="0"
                                                AnchorPane.topAnchor="0">
                                        <top>
                                            <HBox alignment="CENTER_RIGHT" spacing="5">
                                                <MFXButton buttonType="RAISED" fx:id="cookiesAddButton" text="+"/>
                                                <MFXButton buttonType="RAISED" fx:id="cookiesDelButton" text="-"/>
                                            </HBox>
                                        </top>
                                        <center>
                                            <TreeTableView fx:id="cookies" editable="true"
                                                       AnchorPane.bottomAnchor="0"
                                                       AnchorPane.leftAnchor="0"
                                                       AnchorPane.rightAnchor="0"
                                                       AnchorPane.topAnchor="0">
                                                <columns>
                                                    <TreeTableColumn fx:id="cookiesKey"
                                                                     text="%col.key" minWidth="140"/>
                                                    <TreeTableColumn fx:id="cookiesValue"
                                                                     text="%col.value" minWidth="140"/>
                                                    <TreeTableColumn fx:id="cookiesDescription"
                                                                     text="%col.description" minWidth="140"/>
                                                </columns>
                                            </TreeTableView>
                                        </center>
                                    </BorderPane>
                                </AnchorPane>
                            </Tab>
                            <Tab text="%tab.body">
                                <AnchorPane>
                                    <BorderPane AnchorPane.bottomAnchor="0"
                                                AnchorPane.leftAnchor="0"
                                                AnchorPane.rightAnchor="0"
                                                AnchorPane.topAnchor="0">
                                        <top>
                                            <VBox spacing="8" style="-fx-padding: 12;">
                                                <!-- Body 类型选择 -->
                                                <HBox alignment="CENTER_LEFT" spacing="12">
                                                    <Label text="%label.body_type" style="-fx-font-weight: bold; -fx-text-fill: -theme-text-primary;"/>
                                                    <RadioButton fx:id="noneRadioButton" text="%radio.none" toggleGroup="$bodyTypeToggleGroup" selected="true"/>
                                                    <RadioButton fx:id="rawRadioButton" text="%radio.raw" toggleGroup="$bodyTypeToggleGroup"/>
                                                    <RadioButton fx:id="formDataRadioButton" text="%radio.form_data" toggleGroup="$bodyTypeToggleGroup"/>
                                                    <RadioButton fx:id="xwwwFormUrlencodedRadioButton" text="%radio.x_www_form_urlencoded" toggleGroup="$bodyTypeToggleGroup"/>
                                                    <RadioButton fx:id="binaryRadioButton" text="%radio.binary" toggleGroup="$bodyTypeToggleGroup"/>
                                                </HBox>
                                                
                                                <!-- 内容类型选择 -->
                                                <HBox alignment="CENTER_LEFT" spacing="12" visible="false" fx:id="contentTypeHBox">
                                                    <Label text="%label.content_type" style="-fx-font-weight: bold; -fx-text-fill: -theme-text-primary;"/>
                                                    <MFXFilterComboBox fx:id="chooseMediaTypeComboBox"
                                                                       floatingText="%floatingText.content_type"
                                                                       prefWidth="200.0"
                                                                       style="-fx-background-color: -theme-bg-tertiary; -fx-border-color: -theme-border; -fx-border-radius: 4;">
                                                        <items>
                                                            <FXCollections fx:factory="observableArrayList">
                                                                <String fx:value="application/json"/>
                                                                <String fx:value="application/xml"/>
                                                                <String fx:value="text/xml"/>
                                                                <String fx:value="text/plain"/>
                                                                <String fx:value="text/html"/>
                                                                <String fx:value="application/javascript"/>
                                                                <String fx:value="application/x-www-form-urlencoded"/>
                                                                <String fx:value="multipart/form-data"/>
                                                                <String fx:value="multipart/mixed"/>
                                                            </FXCollections>
                                                        </items>
                                                    </MFXFilterComboBox>
                                                    
                                                    <!-- 格式化按钮 -->
                                                    <MFXButton fx:id="formatButton" buttonType="RAISED" 
                                                               prefHeight="28.0" prefWidth="60.0"
                                                               style="-fx-background-color: -theme-bg-tertiary; -fx-text-fill: -theme-text-inverse; -fx-background-radius: 4;"
                                                               text="%button.format">
                                                        <tooltip>
                                                            <Tooltip text="%tooltip.format"/>
                                                        </tooltip>
                                                    </MFXButton>
                                                    
                                                    <!-- 清空按钮 -->
                                                    <MFXButton fx:id="clearBodyButton" buttonType="RAISED" 
                                                               prefHeight="28.0" prefWidth="60.0"
                                                               style="-fx-background-color: -theme-danger; -fx-text-fill: -theme-text-inverse; -fx-background-radius: 4;"
                                                               text="%button.clear_body">
                                                        <tooltip>
                                                            <Tooltip text="%tooltip.clear_body"/>
                                                        </tooltip>
                                                    </MFXButton>
                                                </HBox>
                                            </VBox>
                                        </top>
                                
                                        <center>
                                            <StackPane fx:id="bodyContentPane" AnchorPane.bottomAnchor="0"
                                                       AnchorPane.leftAnchor="0"
                                                       AnchorPane.rightAnchor="0"
                                                       AnchorPane.topAnchor="0">
                                                <!-- Raw 文本编辑器 -->
                                                <AnchorPane fx:id="rawBodyPane">
                                                    <VirtualizedScrollPane AnchorPane.bottomAnchor="0"
                                                                           AnchorPane.leftAnchor="0"
                                                                           AnchorPane.rightAnchor="0"
                                                                           AnchorPane.topAnchor="0">
                                                        <content>
                                                            <CustomTextArea fx:id="inputTextArea" 
                                                                            style="-fx-font-family: 'Consolas', 'Monaco', monospace; -fx-font-size: 13;"/>
                                                        </content>
                                                    </VirtualizedScrollPane>
                                                </AnchorPane>
                                                
                                                <!-- Form-data 编辑器容器 -->
                                                <AnchorPane fx:id="formDataPane" visible="false" managed="false">
                                                </AnchorPane>
                                                
                                                <!-- x-www-form-urlencoded 编辑器容器 -->
                                                <AnchorPane fx:id="urlEncodedPane" visible="false" managed="false">
                                                </AnchorPane>
                                                
                                                <!-- None 提示 -->
                                                <VBox fx:id="noneBodyPane" alignment="CENTER" spacing="8" 
                                                      visible="true" style="-fx-background-color: -theme-bg-secondary;">
                                                    <Label text="%label.no_body" style="-fx-text-fill: -theme-text-secondary; -fx-font-size: 14px;"/>
                                                    <Label text="%label.select_body_type" style="-fx-text-fill: -theme-text-secondary; -fx-font-size: 12px;"/>
                                                </VBox>
                                            </StackPane>
                                        </center>
                                    </BorderPane>
                                </AnchorPane>
                            </Tab>
                        </TabPane>
                    </AnchorPane>
                    <AnchorPane minHeight="0.0" minWidth="0.0">
                        <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                            <top>
                                <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: -theme-bg-secondary; -fx-border-color: -theme-border; -fx-border-width: 0 0 1 0;">
                                    <!-- 响应状态信息 -->
                                    <HBox alignment="CENTER_LEFT" spacing="20">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="%label.status" style="-fx-font-weight: bold; -fx-text-fill: -theme-text-primary;"/>
                                            <Label fx:id="statusCodeLabel" text="-" style="-fx-font-weight: bold; -fx-text-fill: -theme-success;"/>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="%label.time" style="-fx-font-weight: bold; -fx-text-fill: -theme-text-primary;"/>
                                            <Label fx:id="responseTimeLabel" text="-" style="-fx-text-fill: -theme-text-secondary;"/>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="%label.size" style="-fx-font-weight: bold; -fx-text-fill: -theme-text-primary;"/>
                                            <Label fx:id="responseSizeLabel" text="-" style="-fx-text-fill: -theme-text-secondary;"/>
                                        </HBox>
                                    </HBox>
                                    
                                    <!-- 响应标签页 -->
                                    <TabPane fx:id="responseTabPane" tabClosingPolicy="UNAVAILABLE" style="-fx-tab-min-width: 80;">
                                        <Tab text="%tab.response_body">
                                            <AnchorPane>
                                                <VirtualizedScrollPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                                    <content>
                                                        <CustomTextArea fx:id="outputTextArea" wrapText="true" 
                                                                        style="-fx-font-family: 'Consolas', 'Monaco', monospace; -fx-font-size: 13;"/>
                                                    </content>
                                                </VirtualizedScrollPane>
                                            </AnchorPane>
                                        </Tab>
                                        <Tab text="%tab.response_headers">
                                            <AnchorPane>
                                                <TreeTableView fx:id="responseHeaders" editable="false" 
                                                               AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                                    <columns>
                                                        <TreeTableColumn fx:id="responseHeadersKey" text="%col.header_name" minWidth="200"/>
                                                        <TreeTableColumn fx:id="responseHeadersValue" text="%col.value" minWidth="300"/>
                                                    </columns>
                                                </TreeTableView>
                                            </AnchorPane>
                                        </Tab>
                                        <Tab text="%tab.response_cookies">
                                            <AnchorPane>
                                                <TreeTableView fx:id="responseCookies" editable="false"
                                                               AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                                    <columns>
                                                        <TreeTableColumn fx:id="responseCookiesKey" text="%col.cookies_name" minWidth="150"/>
                                                        <TreeTableColumn fx:id="responseCookiesValue" text="%col.value" minWidth="200"/>
                                                        <TreeTableColumn fx:id="responseCookiesDomain" text="%col.domain" minWidth="150"/>
                                                        <TreeTableColumn fx:id="responseCookiesPath" text="%col.path" minWidth="100"/>
                                                    </columns>
                                                </TreeTableView>
                                            </AnchorPane>
                                        </Tab>
                                    </TabPane>
                                </VBox>
                            </top>
                        </BorderPane>
                    </AnchorPane>
                </SplitPane>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
