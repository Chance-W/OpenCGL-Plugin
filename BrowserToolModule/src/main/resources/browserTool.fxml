<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.web.WebView?>

<BorderPane fx:id="contentBorderPane" xmlns="http://javafx.com/javafx/8.0.999-ea" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.opencgl.controller.WebSourcesToolController">
    <center>
      <!--  <WebView fx:id="showHtmlWebView" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets top="10.0"/>
            </BorderPane.margin>
        </WebView>-->
    </center>
    <top>
        <HBox alignment="CENTER" prefHeight="37.0" prefWidth="992.0" spacing="5.0" BorderPane.alignment="CENTER">
            <Label text="网址："/>
            <TextField fx:id="urlTextField" prefHeight="23.0" prefWidth="500.0" HBox.hgrow="ALWAYS"/>
            <Button fx:id="jumpButton" mnemonicParsing="false" onAction="#jumpAction" text="跳转"/>
            <Button fx:id="homePageReturnHome" mnemonicParsing="false" onAction="#returnHomePage" text="返回首页"/>
            <Button fx:id="browserOpenButton" mnemonicParsing="false" onAction="#browserOpenAction"
                    text="在默认浏览器中打开"/>
        </HBox>
    </top>
</BorderPane>
