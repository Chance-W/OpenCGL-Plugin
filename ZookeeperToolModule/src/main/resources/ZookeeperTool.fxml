                                          <BorderPane.margin>
                                              <Insets bottom="5.0" top="5.0"/>
                                          </BorderPane.margin>
                                      </HBox>
                                  </top>
                                  <center>
                                      <TextArea fx:id="nodeDataValueTextArea" BorderPane.alignment="CENTER"/>
                                  </center>
                              </BorderPane>
                          </content>
                      </Tab>
                      <Tab fx:id="nodeMetadataTab" text="%tab.node_metadata">
                          <content>
                              <GridPane>
                                  <columnConstraints>
                                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="267.0" minWidth="10.0"
