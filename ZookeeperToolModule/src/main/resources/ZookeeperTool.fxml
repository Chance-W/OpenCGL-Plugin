                                      <TextField fx:id="DATA_LENGTHTextField" editable="false" GridPane.columnIndex="1"
                                                 GridPane.rowIndex="4"/>
                                      <TextField fx:id="EPHEMERAL_OWNERTextField" editable="false"
                                                 GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                                      <TextField fx:id="M_TIMETextField" editable="false" GridPane.columnIndex="1"
                                                 GridPane.rowIndex="6"/>
                                      <TextField fx:id="MZXIDTextField" editable="false" GridPane.columnIndex="1"
                                                 GridPane.rowIndex="7"/>
                                      <TextField fx:id="NUM_CHILDRENTextField" editable="false" GridPane.columnIndex="1"
                                                 GridPane.rowIndex="8"/>
                                      <TextField fx:id="PZXIDTextField" editable="false" GridPane.columnIndex="1"
                                                 GridPane.rowIndex="9"/>
                                      <TextField fx:id="VERSIONTextField" editable="false" GridPane.columnIndex="1"
                                                 GridPane.rowIndex="10"/>
                                      <Label fx:id="creationTimeLabel" text="%label.creation_time" GridPane.rowIndex="1"/>
                                      <Label fx:id="childrenVersionLabel" text="%label.children_version" GridPane.rowIndex="2"/>
                                      <Label fx:id="creationIdLabel" text="%label.creation_id" GridPane.rowIndex="3"/>
                                      <Label fx:id="dataLengthLabel" text="%label.data_length" GridPane.rowIndex="4"/>
                                      <Label fx:id="ephemeralOwnerLabel" text="%label.ephemeral_owner" GridPane.rowIndex="5"/>
                                      <Label fx:id="lastModifiedTimeLabel" text="%label.last_modified_time" GridPane.rowIndex="6"/>
                                      <Label fx:id="modifiedIdLabel" text="%label.modified_id" GridPane.rowIndex="7"/>
                                      <Label fx:id="numChildrenLabel" text="%label.num_children" GridPane.rowIndex="8"/>
                                      <Label fx:id="nodeIdLabel" text="%label.node_id" GridPane.rowIndex="9"/>
                                      <Label fx:id="dataVersionLabel" text="%label.data_version" GridPane.rowIndex="10"/>
                                  </children>
                                  <padding>
                                      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                                  </padding>
                              </GridPane>
                          </content>
                      </Tab>
                      <Tab fx:id="nodeAclTab" text="%tab.node_acl">
