                                    <Label fx:id="idLabel" layoutX="14.0" layoutY="53.0" text="%label.id"/>
                                    <TextField fx:id="aclIdTextField" editable="false" layoutX="98.0" layoutY="49.0"/>
                                    <Label fx:id="permissionsLabel" layoutX="14.0" layoutY="94.0" text="%label.permissions"/>
                                    <TextField fx:id="aclPermissionsTextField" editable="false" layoutX="98.0"
                                               layoutY="90.0"/>
                                </children>
                            </AnchorPane>
                          </content>
