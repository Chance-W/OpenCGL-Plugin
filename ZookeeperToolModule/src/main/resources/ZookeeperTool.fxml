                          <Button fx:id="searchAllButton" />
                          <Button fx:id="cancelSearchButton" />
                          <Button fx:id="clearSearchButton" />
                          <ProgressIndicator fx:id="searchProgress" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18" />
                      </HBox>
                      <Label fx:id="searchStatus" wrapText="true" />
                      <TreeView fx:id="nodeTreeView" VBox.vgrow="ALWAYS" />
                  </VBox>
                  <TabPane tabClosingPolicy="UNAVAILABLE">
                      <Tab fx:id="nodeDataTab" text="%tab.node_data">
                          <content>
                              <BorderPane>
                                  <top>
                                      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
                                          <children>
                                              <Button fx:id="nodeDataSaveButton" mnemonicParsing="false"
                                                      onAction="#nodeDataSaveOnAction" text="%button.save"/>
