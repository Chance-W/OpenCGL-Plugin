      <VBox fx:id="connectionSidebar" minWidth="200" prefWidth="250" />
      <BorderPane minWidth="500">
         <top>
          <VBox spacing="6">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="connectionNameField" HBox.hgrow="ALWAYS" />
                <Button fx:id="saveConnectionButton" onAction="#saveConnectionOnAction" />
            </HBox>
            <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="zkServersLabel" text="%label.zk_servers" />
                  <TextField fx:id="zkServersTextField" text="%default.zk_servers" />
                  <Label fx:id="connectionTimeoutLabel" text="%label.connection_timeout" />
                  <Spinner fx:id="connectionTimeoutSpinner" prefHeight="23.0" prefWidth="84.0" />
                  <Button fx:id="connectButton" mnemonicParsing="false" onAction="#connectOnAction" text="%button.connect" />
                  <Button fx:id="disconnectButton" mnemonicParsing="false" onAction="#disconnectOnAction" text="%button.disconnect" />
                  <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#refreshOnAction" text="%button.refresh" />
