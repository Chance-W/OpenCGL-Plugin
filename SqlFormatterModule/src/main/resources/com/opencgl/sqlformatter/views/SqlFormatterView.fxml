<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.opencgl.sqlformatter.controller.SqlFormatterController">
    <top>
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%label.dialect"/>
                <ComboBox fx:id="dialectCombo" maxWidth="150"/>
                <Button fx:id="formatButton" text="%btn.format"/>
                <Button fx:id="compressButton" text="%btn.compress"/>
                <Button fx:id="copyButton" text="%btn.copy"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" text="%label.statusReady" style="-fx-text-fill: -theme-text-secondary;"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.5" orientation="HORIZONTAL">
            <VBox spacing="5">
                <padding><Insets top="0" right="5" bottom="10" left="10"/></padding>
                <Label text="%label.input" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="inputArea" promptText="%prompt.input" wrapText="false"
                          style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 13px;" VBox.vgrow="ALWAYS"/>
            </VBox>
            <VBox spacing="5">
                <padding><Insets top="0" right="10" bottom="10" left="5"/></padding>
                <Label text="%label.output" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="outputArea" editable="false" wrapText="false"
                          style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 13px;" VBox.vgrow="ALWAYS"/>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
