<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.opencgl.propertieseditor.controller.PropertiesEditorController">
    <top>
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnOpen" text="%btn.open" onAction="#onOpen"/>
                <Button fx:id="btnSave" text="%btn.save" onAction="#onSave"/>
                <Label text="%label.encoding" style="-fx-text-fill: -theme-text-primary;"/>
                <ComboBox fx:id="encodingCombo" prefWidth="120"/>
                <Button fx:id="btnExportYamlJson" text="%btn.exportYamlJson" onAction="#onExportYamlJson"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="5" BorderPane.alignment="CENTER">
            <padding><Insets top="0" right="10" bottom="10" left="10"/></padding>
            <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colKey" text="%label.key" prefWidth="200"/>
                    <TableColumn fx:id="colValue" text="%label.value" prefWidth="300"/>
                </columns>
                <placeholder>
                    <Label text="%status.ready"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10;">
            <Label fx:id="statusLabel" text="%status.ready" style="-fx-text-fill: -theme-text-secondary;"/>
        </HBox>
    </bottom>
</BorderPane>
