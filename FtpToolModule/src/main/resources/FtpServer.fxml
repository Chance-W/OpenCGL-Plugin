<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitMenuButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane fx:id="mainAnchorPane" prefHeight="475.0" prefWidth="813.0" xmlns="http://javafx.com/javafx/8.0.111" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.opencgl.ftp.controller.FtpServerController">
   <children>
      <BorderPane layoutX="14.0" layoutY="7.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
         <top>
            <HBox alignment="CENTER" spacing="2.0" BorderPane.alignment="CENTER">
               <children>
                  <Label text="%label.username" />
                  <TextField fx:id="userNameTextField" prefHeight="23.0" prefWidth="72.0" />
                  <Label text="%label.password" />
                  <TextField fx:id="passwordTextField" prefHeight="23.0" prefWidth="88.0" />
                  <Label text="%label.shared_dir" />
                  <TextField fx:id="homeDirectoryTextField" promptText="%prompt.shared_dir" />
                  <Button fx:id="chooseHomeDirectoryButton" mnemonicParsing="false" onAction="#chooseHomeDirectoryAction" text="%button.choose" />
                  <CheckBox fx:id="downFileCheckBox" mnemonicParsing="false" selected="true" text="%check.download" />
                  <CheckBox fx:id="upFileCheckBox" mnemonicParsing="false" selected="true" text="%check.upload" />
                  <CheckBox fx:id="deleteFileCheckBox" mnemonicParsing="false" selected="true" text="%check.readwrite">
                     <tooltip>
                        <Tooltip text="%tooltip.readwrite" />
                     </tooltip>
                  </CheckBox>
                  <Button fx:id="buttonAddItem" mnemonicParsing="false" onAction="#addItemAction" text="%button.add" />
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
            </HBox>
         </top>
         <bottom>
            <HBox alignment="CENTER" spacing="5.0" BorderPane.alignment="CENTER">
               <children>
                  <SplitMenuButton mnemonicParsing="false" onAction="#saveConfigure" popupSide="TOP" text="%button.save_config">
                    <items>
                      <MenuItem mnemonicParsing="false" onAction="#otherSaveConfigureAction" text="%menu.save_as" />
                      <MenuItem mnemonicParsing="false" onAction="#loadingConfigureAction" text="%menu.load_config" />
                    </items>
                  </SplitMenuButton>
                  <Label text="%label.server_port" />
                  <TextField fx:id="portTextField" prefHeight="23.0" prefWidth="61.0" text="21" />
                  <CheckBox fx:id="anonymousLoginEnabledCheckBox" mnemonicParsing="false" text="%check.anonymous" />
                  <TextField fx:id="anonymousLoginEnabledTextField" disable="true" promptText="%prompt.anonymous_dir" />
                  <Button fx:id="anonymousLoginEnabledButton" disable="true" mnemonicParsing="false" onAction="#anonymousLoginEnabledAction" text="%button.choose" />
                  <Label text="%label.max_connections" />
                  <Spinner fx:id="maxConnectCountSpinner" editable="true" prefHeight="23.0" prefWidth="77.0" />
                  <Button fx:id="startButton" mnemonicParsing="false" onAction="#startAction" text="%button.start" />
               </children>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
            </HBox>
         </bottom>
         <center>
            <TableView fx:id="tableViewMain" editable="true" prefHeight="314.0" prefWidth="759.0" BorderPane.alignment="CENTER">
              <columns>
                  <TableColumn fx:id="isEnabledTableColumn" prefWidth="75.0" text="%column.enabled" />
                <TableColumn fx:id="userNameTableColumn" prefWidth="102.0" sortable="false" text="%column.username" />
                <TableColumn fx:id="passwordTableColumn" prefWidth="150.0" sortable="false" text="%column.password" />
                  <TableColumn fx:id="homeDirectoryTableColumn" prefWidth="112.0" sortable="false" text="%column.shared_dir" />
                  <TableColumn fx:id="downFIleTableColumn" prefWidth="112.0" sortable="false" text="%column.download" />
                  <TableColumn fx:id="upFileTableColumn" minWidth="0.0" prefWidth="160.0" sortable="false" text="%column.upload" />
                  <TableColumn fx:id="deleteFileTableColumn" prefWidth="122.0" sortable="false" text="%column.readwrite" />
              </columns>
               <BorderPane.margin>
                  <Insets bottom="5.0" top="5.0" />
               </BorderPane.margin>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
