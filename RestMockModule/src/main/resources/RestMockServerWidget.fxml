<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.ProgressIndicator?>

<StackPane fx:id="mainStackPane" styleClass="rest-mock-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.opencgl.controller.RestMockServerWidgetController">

    <VBox fx:id="mainWrap" styleClass="rest-mock-wrap" spacing="0">

        <!-- 顶部工具栏 -->
        <HBox styleClass="rest-mock-toolbar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Label text="%label.port" styleClass="rest-mock-toolbar-label"/>
            <TextField fx:id="portTextField" text="8080" minWidth="72" maxWidth="72" styleClass="rest-mock-port-field"/>
            <Button fx:id="startButton" text="%btn.start" styleClass="rest-mock-btn-primary"/>
            <Button fx:id="stopButton" text="%btn.stop" styleClass="rest-mock-btn-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox fx:id="stateHbox" alignment="CENTER_RIGHT" spacing="6">
                <Label fx:id="statusLabel" styleClass="rest-mock-status"/>
                <ProgressIndicator fx:id="statusProcessBar" styleClass="rest-mock-progress" prefWidth="24" prefHeight="24" visible="false"/>
            </HBox>
        </HBox>

        <!-- 主内容区: 左右分栏 -->
        <SplitPane fx:id="mainSplitPane" dividerPositions="0.40" VBox.vgrow="ALWAYS">

            <!-- ====== 左侧: 规则列表 ====== -->
            <VBox styleClass="rest-mock-left-panel" spacing="8" SplitPane.resizableWithParent="false">
                <padding><Insets top="12" right="10" bottom="10" left="10"/></padding>

                <!-- 左侧工具栏: 添加按钮 + 搜索框 -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="addRuleButton" text="%btn.addRule" styleClass="rest-mock-btn-primary"/>
                    <TextField fx:id="searchField" promptText="%prompt.search" HBox.hgrow="ALWAYS" styleClass="rest-mock-search-field"/>
                </HBox>

                <!-- 规则列表表格（简化列）-->
                <TableView fx:id="tableViewMain" editable="true" VBox.vgrow="ALWAYS" styleClass="rest-mock-table">
                    <columns>
                        <TableColumn fx:id="isEnabledTableColumn" prefWidth="64" text="%col.enabled"/>
                        <TableColumn fx:id="methodTableColumn" prefWidth="60" sortable="false" text="%col.method"/>
                        <TableColumn fx:id="contentPathTableColumn" prefWidth="160" sortable="false" text="%col.contextPath"/>
                        <TableColumn fx:id="desTableColumn" minWidth="80" sortable="false" text="%col.desc"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>

            <!-- ====== 右侧: 动态详情面板 ====== -->
            <StackPane fx:id="rightContentArea">

                <!-- 空状态提示 -->
                <VBox fx:id="emptyState" alignment="CENTER" spacing="20">
                    <Label text="%message.emptyState" style="-fx-font-size: 14px; -fx-text-fill: -theme-text-secondary;"/>
                </VBox>

                <!-- 规则详情编辑面板 -->
                <VBox fx:id="ruleDetailPane" visible="false" managed="false" spacing="12" VBox.vgrow="ALWAYS">
                    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

                    <!-- 标题行 + 操作按钮 -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label fx:id="ruleDetailTitle" text="%label.ruleConfig" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="deleteRuleButton" text="%btn.delete" styleClass="rest-mock-btn-danger"/>
                        <Button fx:id="saveRuleButton" text="%btn.save" styleClass="rest-mock-btn-primary"/>
                    </HBox>

                    <Separator/>

                    <!-- 表单区域 -->
                    <VBox spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="%label.httpMethod" prefWidth="100" alignment="CENTER_RIGHT"/>
                            <ComboBox fx:id="httpMethodCombo" prefWidth="120"/>
                            <Label text="%label.statusCode" prefWidth="80" alignment="CENTER_RIGHT"/>
                            <ComboBox fx:id="statusCodeCombo" prefWidth="100"/>
                            <Label text="%label.delayMs" prefWidth="80" alignment="CENTER_RIGHT"/>
                            <TextField fx:id="delayMsField" prefWidth="80" text="0" alignment="CENTER"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="%label.path" prefWidth="100" alignment="CENTER_RIGHT"/>
                            <TextField fx:id="contentPath" promptText="%prompt.path" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="%label.desc" prefWidth="100" alignment="CENTER_RIGHT"/>
                            <TextField fx:id="des" promptText="%prompt.interfaceDesc" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <Separator/>

                    <!-- Response Header -->
                    <VBox spacing="6">
                        <Label text="%label.responseHeaderSection" style="-fx-font-weight: bold; -fx-text-fill: -theme-text-secondary;"/>
                        <TextField fx:id="responseHeader" promptText="%prompt.responseHeader"/>
                    </VBox>

                    <Separator/>

                    <!-- Response Body -->
                    <VBox spacing="6" VBox.vgrow="ALWAYS">
                        <Label text="%label.responseBodySection" style="-fx-font-weight: bold; -fx-text-fill: -theme-text-secondary;"/>
                        <TextArea fx:id="responseContent" wrapText="true" VBox.vgrow="ALWAYS" styleClass="rest-mock-body-editor"
                                  promptText="%prompt.responseBody"/>
                    </VBox>
                </VBox>
            </StackPane>
        </SplitPane>

        <!-- 底部请求日志（可折叠） -->
        <TitledPane fx:id="logDrawerPane" text="%label.requestLog" collapsible="true" expanded="false" styleClass="rest-mock-log-drawer">
            <TextArea fx:id="outputTextArea" wrapText="true" editable="false" styleClass="rest-mock-log-area" prefHeight="200" minHeight="120"/>
        </TitledPane>
    </VBox>
</StackPane>
