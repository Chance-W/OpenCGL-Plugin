<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.text.Text?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import com.opencgl.base.controls.CustomTextArea?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import org.fxmisc.flowless.VirtualizedScrollPane?>
<?import io.github.palexdev.materialfx.controls.MFXProgressBar?>
<StackPane fx:id="mainStackPane" xmlns="http://javafx.com/javafx/10.0.2-internal" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.opencgl.controller.RestMockServerWidgetController">
    <SplitPane dividerPositions="0.8" orientation="VERTICAL" fx:id="splitPane">
        <AnchorPane>
            <BorderPane layoutX="14.0" layoutY="7.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0"
                        AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                <top>
                    <VBox>
                        <HBox alignment="CENTER_LEFT" spacing="30">
                            <MFXTextField minWidth="100" promptText="Path(eg:/product/)" fx:id="contentPath"/>
                            <MFXTextField minWidth="100" promptText="Response Header" fx:id="responseHeader"/>
                            <HBox fx:id="responseContentHbox">
                                <CustomTextArea minWidth="200" fx:id="responseContent"/>
                                <!-- <MFXButton minWidth="100" fx:id="responseContentButton" text="点我配置返回样例"/>-->
                            </HBox>
                            <MFXTextField minWidth="200" promptText="接口描述" fx:id="des"/>
                            <MFXButton fx:id="addButton" onAction="#addItemAction" text="+"/>
                        </HBox>
                    </VBox>
                </top>
                <center>
                    <TableView fx:id="tableViewMain" editable="true" prefHeight="314.0" prefWidth="759.0"
                               BorderPane.alignment="CENTER">
                        <columns>
                            <TableColumn fx:id="isEnabledTableColumn" prefWidth="50.0" text="是否启用"/>
                            <TableColumn fx:id="contentPathTableColumn" prefWidth="180.0" sortable="false"
                                         text="Context-Path"/>
                            <TableColumn fx:id="responseHeaderTableColumn" prefWidth="180.0" sortable="false"
                                         text="Response Header"/>
                            <TableColumn fx:id="responseContentTableColumn" prefWidth="180.0" sortable="false"
                                         text="Response Content"/>
                            <TableColumn fx:id="desTableColumn" prefWidth="112.0" sortable="180.0" text="接口说明"/>
                            <TableColumn fx:id="stateTableColumn" minWidth="0.0" prefWidth="20.0" sortable="false"/>
                        </columns>
                        <BorderPane.margin>
                            <Insets bottom="5.0" top="5.0"/>
                        </BorderPane.margin>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </center>
                <bottom>
                    <HBox alignment="CENTER_LEFT" spacing="5.0" BorderPane.alignment="CENTER">
                        <HBox fx:id="stateHbox" alignment="CENTER_LEFT" spacing="5.0">
                            <Text text="运行状态:"/>
                            <MFXProgressBar fx:id="statusProcessBar" styleClass="custom-jfx-progress-bar-stroke"/>
                        </HBox>
                        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="5.0">
                            <MFXTextField minWidth="20" promptText="端口:1~65535" fx:id="portTextField"/>
                            <MFXButton fx:id="startButton" text="启动"/>
                            <MFXButton fx:id="stopButton" text="停止"/>
                        </HBox>
                    </HBox>
                </bottom>
            </BorderPane>
        </AnchorPane>
        <AnchorPane minHeight="0.0" minWidth="0.0">
            <VirtualizedScrollPane AnchorPane.bottomAnchor="0"
                                   AnchorPane.leftAnchor="0"
                                   AnchorPane.rightAnchor="0"
                                   AnchorPane.topAnchor="0">
                <content>
                    <CustomTextArea wrapText="true" fx:id="outputTextArea"/>
                </content>
            </VirtualizedScrollPane>
        </AnchorPane>
    </SplitPane>
</StackPane>
