<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<?import io.github.palexdev.materialfx.controls.MFXComboBox?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import com.opencgl.base.controls.CustomTextArea?>
<StackPane fx:id="mainStackPane" xmlns="http://javafx.com/javafx/10.0.2-internal" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.xtool.opencgl.controller.JsonXmlFormatWidgetController">
    <BorderPane fx:id="contentBorderPane" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <top>
            <VBox fx:id="operateTopVbox" spacing="1.0" style="-fx-background-color:WHITE" BorderPane.alignment="CENTER">
                <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-background-color:WHITE">
                    <MFXComboBox fx:id="formatTypeComboBox" prefWidth="130.0" maxHeight="40.0"
                                 style="-fx-prompt-text-fill:rgba(63,75,77,0.39)" text="JSON">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="JSON"/>
                                <String fx:value="XML"/>
                            </FXCollections>
                        </items>
                    </MFXComboBox>
                    <MFXButton fx:id="formatButton" text="格式化" buttonType="RAISED" onMouseClicked="#formatLabelAction"
                               prefWidth="100.0"/>
                    <HBox.margin>
                        <Insets right="40.0"/>
                    </HBox.margin>
                    <VBox.margin>
                        <Insets bottom="5.0" top="5.0" right="10.0"/>
                    </VBox.margin>
                </HBox>
            </VBox>
        </top>
        <center>
            <StackPane>
                <SplitPane dividerPositions="0.5">
                    <AnchorPane minHeight="0.0" minWidth="0.0">
                        <CustomTextArea fx:id="inputTextArea"
                                        AnchorPane.bottomAnchor="0"
                                        AnchorPane.leftAnchor="0"
                                        AnchorPane.rightAnchor="0"
                                        AnchorPane.topAnchor="0">
                        </CustomTextArea>
                    </AnchorPane>
                    <AnchorPane minHeight="0.0" minWidth="0.0">
                        <CustomTextArea fx:id="outputTextArea" AnchorPane.bottomAnchor="0"
                                        AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0"/>
                    </AnchorPane>
                </SplitPane>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
