<?xml version="1.0" encoding="UTF-8"?>

<?import org.fxmisc.flowless.VirtualizedScrollPane?>
<?import com.opencgl.base.controls.CustomMFXFilterComboBox?>
<?import com.opencgl.base.controls.CustomTextArea?>
<?import io.github.palexdev.materialfx.controls.MFXCheckbox?>
<?import io.github.palexdev.materialfx.controls.MFXScrollPane?>
<?import io.github.palexdev.mfxresources.fonts.MFXFontIcon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<StackPane fx:id="mainStackPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.opencgl.dubbo.controller.DubboWidgetController">
    <BorderPane fx:id="contentBorderPane" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- TOP AREA: Request Header -->
        <top>
            <VBox spacing="5">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <!-- Environment -->
                    <CustomMFXFilterComboBox fx:id="chooseEnvComboBox" allowEdit="true" floatMode="DISABLED"
                                             prefWidth="120" promptText="%label.env" scrollOnOpen="true" selectable="true"
                                             style="-fx-prompt-text-fill: -theme-text-secondary;"/>
                    <Button fx:id="manageEnvButton" onMouseClicked="#manageEnvAction" text=""
                            styleClass="icon-button" visible="true">
                        <graphic>
                            <MFXFontIcon description="fas-gear" size="14.0"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="%tooltip.env_config"/>
                        </tooltip>
                    </Button>

                    <!-- Interface -->
                    <CustomMFXFilterComboBox fx:id="chooseIntComboBox" allowEdit="true" editable="true"
                                             floatMode="DISABLED" prefWidth="400" promptText="%label.interface"
                                             scrollOnOpen="true" selectable="true" HBox.hgrow="ALWAYS"/>

                    <!-- Method -->
                    <CustomMFXFilterComboBox fx:id="chooseMetComboBox" allowEdit="true" editable="true"
                                             floatMode="DISABLED" prefWidth="150" promptText="%label.method"
                                             scrollOnOpen="true" selectable="true"
                                             style="-fx-prompt-text-fill: -theme-text-secondary;"/>

                    <!-- Actions -->
                    <Button fx:id="sendButton" onMouseClicked="#sendLabelAction" styleClass="primary-button"
                            text="%label.send">
                        <graphic>
                            <MFXFontIcon description="fas-play" size="14.0"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="%tooltip.send"/>
                        </tooltip>
                    </Button>

                    <Button fx:id="saveButton" onMouseClicked="#saveLabelAction" styleClass="secondary-button"
                            text="%label.save">
                        <graphic>
                            <MFXFontIcon description="fas-floppy-disk" size="14.0"/>
                        </graphic>
                    </Button>

                    <Button fx:id="copyButton" onMouseClicked="#copyLabelAction" styleClass="secondary-button"
                            text="%label.copy">
                        <graphic>
                            <MFXFontIcon description="fas-copy" size="14.0"/>
                        </graphic>
                    </Button>

                    <Button fx:id="importButton" onMouseClicked="#importLabelAction" styleClass="secondary-button"
                            text="%label.import">
                        <graphic>
                            <MFXFontIcon description="fas-file-import" size="14.0"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </top>

        <!-- CENTER AREA: SplitPane (Request / Response) -->
        <center>
                <StackPane fx:id="centerStackPane">
                    <!-- 1. Request Configuration (Default View) -->
                    <TabPane fx:id="requestTabPane" tabClosingPolicy="UNAVAILABLE">
                        <!-- Tab: Body (JSON) -->
                        <Tab fx:id="requestBodyTab" text="%tab.body_json">
                            <SplitPane orientation="VERTICAL" dividerPositions="0.6">
                                <StackPane fx:id="contentInputAndOutputPane"> <!-- Kept ID for loading mask -->
                                    <VirtualizedScrollPane>
                                        <content>
                                            <CustomTextArea fx:id="inputTextArea"/>
                                        </content>
                                    </VirtualizedScrollPane>
                                </StackPane>

                                <!-- Response Output Area (Moved here) -->
                                <VBox>
                                    <!-- Status Bar -->
                                    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 5px;">
                                        <Label fx:id="statusLabel" styleClass="status-success" text="%label.status_initial"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="timeLabel" text="%label.time_initial"/>
                                        <Label fx:id="sizeLabel" text="%label.size_initial"/>
                                    </HBox>
                                    <VirtualizedScrollPane VBox.vgrow="ALWAYS">
                                        <content>
                                            <CustomTextArea fx:id="outputTextArea" editable="false" styleClass="code-area"/>
                                        </content>
                                    </VirtualizedScrollPane>
                                </VBox>
                            </SplitPane>
                        </Tab>

                        <!-- Tab: Settings (Parameters) -->
                        <Tab fx:id="settingsTab" text="%label.settings">
                            <MFXScrollPane fitToWidth="true">
                                <content>
                                    <VBox spacing="15">
                                        <padding>
                                            <Insets bottom="20" left="20" right="20" top="20"/>
                                        </padding>

                                        <!-- BASIC CONFIG -->
                                        <GridPane hgap="15" vgap="15">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="NEVER" minWidth="120"/>
                                                <ColumnConstraints hgrow="ALWAYS"/>
                                            </columnConstraints>

                                            <Label fx:id="connConfigLabel" style="-fx-font-weight: bold" text="连接配置:" GridPane.columnIndex="0"
                                                   GridPane.rowIndex="0"/>
                                            <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="1"
                                                  GridPane.rowIndex="0">
                                                <Label fx:id="timeoutLabel" text="超时(ms):"/>
                                                <TextField fx:id="timeoutField" prefWidth="100" text="100000"/>
                                                <Label fx:id="retriesLabel" text="重试次数:"/>
                                                <TextField fx:id="retriesField" prefWidth="60" text="0"/>
                                            </HBox>

                                            <Label fx:id="directProviderLabel" style="-fx-font-weight: bold" text="直连提供者 (选填):"
                                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                            <CustomMFXFilterComboBox fx:id="chooseProvideComboBox" allowEdit="true"
                                                                     floatMode="DISABLED" prefWidth="300"
                                                                     promptText="%prompt.direct_provider"
                                                                     scrollOnOpen="true" selectable="true"
                                                                     GridPane.columnIndex="1"
                                                                     GridPane.rowIndex="1"/>

                                            <Label fx:id="reqTypeLabel" style="-fx-font-weight: bold" text="请求类型:" GridPane.columnIndex="0"
                                                   GridPane.rowIndex="2"/>
                                            <TextField fx:id="extRequestType"
                                                       promptText="%prompt.request_type"
                                                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                            <Label fx:id="batchReqLabel" style="-fx-font-weight: bold" text="批量请求:" GridPane.columnIndex="0"
                                                   GridPane.rowIndex="3"/>
                                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                                <Label fx:id="countLabel" text="次数:"/>
                                                <TextField fx:id="requestCountField" prefWidth="100" text="1"/>
                                            </HBox>

                                            <Label fx:id="versionLabel" style="-fx-font-weight: bold" text="服务版本:" GridPane.columnIndex="0"
                                                   GridPane.rowIndex="4"/>
                                            <TextField fx:id="versionField" promptText="%prompt.version"
                                                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                                            <Label fx:id="dubboGroupLabel" style="-fx-font-weight: bold" text="Dubbo 分组:" GridPane.columnIndex="0"
                                                   GridPane.rowIndex="5"/>
                                            <HBox spacing="5" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="5">
                                                <TextField fx:id="dubboGroupField" promptText="%prompt.dubbo_group" HBox.hgrow="ALWAYS">
                                                    <tooltip><Tooltip text="%tooltip.dubbo_group"/></tooltip>
                                                </TextField>
                                            </HBox>

                                            <Label fx:id="implicitParamLabel" style="-fx-font-weight: bold" text="隐式参数:" GridPane.columnIndex="0"
                                                   GridPane.rowIndex="6" GridPane.valignment="TOP"/>
                                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="6">
                                                <CustomTextArea fx:id="attachmentsArea" prefHeight="100" promptText="%prompt.attachments"/>
                                            </VBox>
                                        </GridPane>

                                        <!-- SEPARATOR -->
                                        <Region style="-fx-border-style: solid; -fx-border-color: -theme-border; -fx-border-width: 1 0 0 0;" />

                                        <!-- TLS SECURITY CONFIG -->
                                        <Label fx:id="tlsConfigLabel" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="TLS 安全配置 (双向认证)" />
                                        <GridPane hgap="15" vgap="15">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="NEVER" minWidth="120"/>
                                                <ColumnConstraints hgrow="ALWAYS"/>
                                            </columnConstraints>

                                            <Label fx:id="tlsEnableLabel" style="-fx-font-weight: bold" text="启用 TLS:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                            <MFXCheckbox fx:id="tlsEnableCheckbox" text="" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                            <Label fx:id="clientCertLabel" text="客户端证书 (PEM):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                <TextField fx:id="tlsClientCertPathField" promptText="%prompt.client_cert" HBox.hgrow="ALWAYS"/>
                                                <Button text="..." onMouseClicked="#browseClientCertAction"/>
                                            </HBox>

                                            <Label fx:id="clientKeyLabel" text="客户端私钥 (PEM):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                <TextField fx:id="tlsClientKeyPathField" promptText="%prompt.client_key" HBox.hgrow="ALWAYS"/>
                                                <Button text="..." onMouseClicked="#browseClientKeyAction"/>
                                            </HBox>
                                            
                                            <Label fx:id="keyPassLabel" text="私钥密码:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                            <StackPane alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                                <TextField fx:id="tlsKeyTextFieldVisible" promptText="%prompt.optional" visible="false" managed="false"/>
                                                <PasswordField fx:id="tlsKeyPasswordField" promptText="%prompt.optional"/>
                                                <Button fx:id="tlsKeyToggleBtn" style="-fx-background-color: transparent; -fx-cursor: hand;" onAction="#toggleTlsKeyVisibility">
                                                    <graphic>
                                                        <javafx.scene.shape.SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                                    </graphic>
                                                    <StackPane.margin>
                                                       <Insets right="5"/>
                                                    </StackPane.margin>
                                                </Button>
                                            </StackPane>
            
                                            <Label fx:id="caCertLabel" text="CA 证书 (PEM):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                                <TextField fx:id="tlsCaCertPathField" promptText="%prompt.ca_cert" HBox.hgrow="ALWAYS"/>
                                                <Button text="..." onMouseClicked="#browseCaCertAction"/>
                                            </HBox>
                                        </GridPane>
                                    </VBox>
                                </content>
                            </MFXScrollPane>
                        </Tab>

                        <!-- Tab: Hooks -->
                        <Tab fx:id="hooksTab" text="%label.hooks">
                            <SplitPane dividerPositions="0.6" orientation="VERTICAL">
                                <!-- Top: Config & Preview -->
                                <VBox spacing="10">
                                    <padding>
                                        <Insets bottom="10" left="10" right="10" top="10"/>
                                    </padding>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label fx:id="hookScriptLabel" text="Hook 脚本:"/>
                                        <TextField fx:id="hookScriptPathField" promptText="%prompt.hook_script" HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="browseHookButton" styleClass="secondary-button" text="...">
                                            <tooltip>
                                                <Tooltip text="%tooltip.browse_script"/>
                                            </tooltip>
                                        </Button>
                                        <Button fx:id="saveHookButton" styleClass="secondary-button" text="%label.save_script">
                                            <tooltip>
                                                <Tooltip text="%tooltip.save_script"/>
                                            </tooltip>
                                        </Button>
                                        <Button fx:id="testHookButton" onMouseClicked="#testHookAction"  text="%label.hooks">
                                            <graphic>
                                                <MFXFontIcon description="fas-flask" size="14.0"/>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="%tooltip.test_hook"/>
                                            </tooltip>
                                        </Button>
                                    </HBox>
                                    <Label fx:id="scriptPreviewLabel" text="%label.script_preview"/>
                                    <VirtualizedScrollPane VBox.vgrow="ALWAYS">
                                        <content>
                                            <CustomTextArea fx:id="hookPreviewTextArea" styleClass="code-area"/>
                                        </content>
                                    </VirtualizedScrollPane>
                                </VBox>

                                <!-- Bottom: Output -->
                                <VBox spacing="5">
                                    <padding>
                                        <Insets bottom="5" left="5" right="5" top="5"/>
                                    </padding>
                                    <Label fx:id="testOutputLabel" text="%label.test_output"/>
                                    <VirtualizedScrollPane VBox.vgrow="ALWAYS">
                                        <content>
                                            <CustomTextArea fx:id="hookOutputTextArea" editable="false" styleClass="console-area"/>
                                        </content>
                                    </VirtualizedScrollPane>
                                </VBox>
                            </SplitPane>
                        </Tab>
                    </TabPane>

                    <!-- 2. History Detail View (Hidden by default) -->
                    <!-- 2. History Detail View (Hidden by default) -->
                    <!-- 2. History Detail View (Hidden by default) -->
                </StackPane>
        </center>
    </BorderPane>

    <!-- History Detail Pane (Overlay) -->
    <StackPane fx:id="historyDetailPane" visible="false" styleClass="history-detail-pane">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <VirtualizedScrollPane>
            <content>
                <CustomTextArea fx:id="historyFullTextArea" editable="true" styleClass="code-area"/>
            </content>
        </VirtualizedScrollPane>
    </StackPane>
</StackPane>
