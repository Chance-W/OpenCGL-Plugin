<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.mfxresources.fonts.MFXFontIcon?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="mainAnchorPane" prefHeight="700.0" prefWidth="1100.0" 
            xmlns="http://javafx.com/javafx/8.0.999-ea"
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.opencgl.redis.controller.RedisWidgetController"
            style="-fx-background-color: -theme-bg-secondary;">
    
    <SplitPane fx:id="mainSplitPane" dividerPositions="0.25" 
               AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" 
               AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        
        <!-- 左侧: 连接树 -->
        <VBox spacing="0" style="-fx-background-color: -theme-bg-primary; -fx-border-color: -theme-border; -fx-border-width: 0 1 0 0;">
            <!-- 工具栏 -->
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-background-color: -theme-bg-secondary; -fx-padding: 8 12;">
                <MFXButton fx:id="addConnectionBtn" text="" buttonType="RAISED"
                           prefWidth="32" prefHeight="32"
                           style="-fx-background-color: -theme-accent; -fx-text-fill: -theme-text-inverse;">
                    <graphic>
                        <MFXFontIcon description="fas-plus" size="14.0" style="-fx-text-fill: -theme-text-inverse;"/>
                    </graphic>
                    <tooltip><Tooltip text="%tooltip.add_connection"/></tooltip>
                </MFXButton>
                <MFXButton fx:id="editConnectionBtn" text="" buttonType="RAISED"
                           prefWidth="32" prefHeight="32"
                           style="-fx-background-color: -theme-bg-tertiary; -fx-text-fill: -theme-text-inverse;">
                    <graphic>
                        <MFXFontIcon description="fas-pen" size="12.0" style="-fx-text-fill: -theme-text-inverse;"/>
                    </graphic>
                    <tooltip><Tooltip text="%tooltip.edit_connection"/></tooltip>
                </MFXButton>
                <Region HBox.hgrow="ALWAYS"/>
                <MFXButton fx:id="refreshTreeBtn" text="" buttonType="RAISED"
                           prefWidth="32" prefHeight="32"
                           style="-fx-background-color: -theme-success; -fx-text-fill: -theme-text-inverse;">
                    <graphic>
                        <MFXFontIcon description="fas-arrows-rotate" size="12.0" style="-fx-text-fill: -theme-text-inverse;"/>
                    </graphic>
                    <tooltip><Tooltip text="%tooltip.refresh"/></tooltip>
                </MFXButton>
            </HBox>
            
            <!-- 连接树 -->
            <TreeView fx:id="connectionTree" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent;"/>
        </VBox>
        
        <!-- 右侧: 内容区 -->
        <StackPane>
            <!-- 多开 Tab 容器 -->
            <TabPane fx:id="sessionTabPane" tabClosingPolicy="ALL_TABS" visible="false" managed="false"/>
            
            <!-- 未连接提示空状态 -->
            <VBox fx:id="noConnectionPane" alignment="CENTER" spacing="16" 
                  style="-fx-background-color: -theme-bg-secondary;">
                <Label fx:id="noConnectionLabel" text="%message.select_connection" 
                       style="-fx-font-size: 18px; -fx-text-fill: #6c757d;"/>
                <MFXButton fx:id="createFirstConnectionBtn" text="%button.create_connection" buttonType="RAISED"
                           style="-fx-background-color: -theme-accent; -fx-text-fill: -theme-text-inverse; -fx-padding: 12 24; -fx-font-size: 14px;"/>
            </VBox>
        </StackPane>
    </SplitPane>
</AnchorPane>
