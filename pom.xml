        <module>MqTraceModule</module>
        <module>MongoDBModule</module>
        <module>ElasticsearchModule</module>
        <module>GRPCTestModule</module>
        <module>NacosModule</module>
        <module>DockerModule</module>
        <module>WebSocketModule</module>
        <module>GraphQLModule</module>
        <module>YamlToolModule</module>
        <module>DiffToolModule</module>
        <module>SimpleStaticServerModule</module>
        <module>LanMessengerModule</module>
